# ============================================================
# お菓子管理アプリ 環境変数テンプレート
# このファイルをコピーして .env.local を作り、実際の値を入れてください。
#   cp .env.example .env.local   （PowerShellなら Copy-Item .env.example .env.local）
# .env.local は Git にコミットされません（秘密情報が入るため）。
# ============================================================

# --- Supabase（DB）---
# Supabaseダッシュボード > Project Settings > Data API / API Keys で確認
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role キー。RLSを無視できる強力な鍵。サーバー専用。絶対に公開・NEXT_PUBLIC化しないこと。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- LINE LIFF（ログイン）---
# LINE Developers > LINE Loginチャネル > LIFF タブ で発行される LIFF ID
# NEXT_PUBLIC_ が付く変数はブラウザにも公開される（LIFF IDは公開して問題ない）
NEXT_PUBLIC_LIFF_ID=0000000000-abcdefgh
