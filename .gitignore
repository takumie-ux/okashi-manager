# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# 生成物（掲示用に生成するQR画像。リポジトリには含めない）
/entry-qr.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ただし公開用テンプレートはコミットする（秘密情報は入れないこと）
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
